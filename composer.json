{
    "name": "true-async/yii3-spawn",
    "description": "Yii3 adapter for PHP TrueAsync — async HTTP server with coroutine-per-request isolation",
    "type": "library",
    "license": "MIT",
    "keywords": ["yii3", "trueasync", "async", "coroutine", "http-server"],
    "require": {
        "php": "^8.6",
        "ext-pdo": "*",
        "psr/http-message": "^1.1|^2.0",
        "psr/http-server-handler": "^1.0",
        "httpsoft/http-message": "^1.1",
        "yiisoft/di": "^1.3",
        "yiisoft/yii-runner": "^2.0|^3.0",
        "yiisoft/yii-runner-http": "^2.0|^3.0",
        "yiisoft/yii-http": "^1.0"
    },
    "require-dev": {
        "yiisoft/router": "^3.0|^4.0",
        "yiisoft/router-fastroute": "^3.0|^4.0",
        "yiisoft/session": "^2.0",
        "yiisoft/user": "^2.0",
        "yiisoft/cache": "^3.0",
        "yiisoft/db": "^2.0",
        "yiisoft/db-pgsql": "^2.0",
        "yiisoft/request-provider": "^1.0",
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "yiisoft/db-pgsql": "Enables the TrueAsync PDO connection pool for PostgreSQL",
        "yiisoft/user": "Per-coroutine isolation of the authenticated identity",
        "yiisoft/session": "Per-coroutine session isolation"
    },
    "autoload": {
        "psr-4": {
            "TrueAsync\\Yii3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TrueAsync\\Yii3\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/config": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
